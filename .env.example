# Copy to .env.local and fill in. Never commit real secrets.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB (docker-compose provides a local instance)
MONGODB_URI=mongodb://localhost:27017/fileflip

# Gotenberg (LibreOffice over HTTP). On Railway use the private network URL.
GOTENBERG_URL=http://localhost:3001

# Auth.js (next-auth v5)
AUTH_SECRET=generate-with-npx-auth-secret
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Magic link email (SMTP), e.g. smtp://user:pass@smtp.example.com:587
EMAIL_SERVER=
EMAIL_FROM="FileFlip <no-reply@example.com>"
# Staging without SMTP: print magic links to the server log (never in real production)
AUTH_EMAIL_LOG_LINKS=false

# Mercado Pago (use TEST credentials). Each MP account charges in its own
# country's currency: set one token per country you sell in. MP_ACCESS_TOKEN
# is the fallback for countries without their own token.
MP_ACCESS_TOKEN=
MP_ACCESS_TOKEN_AR=
MP_ACCESS_TOKEN_BR=
MP_ACCESS_TOKEN_MX=
MP_ACCESS_TOKEN_CL=
MP_ACCESS_TOKEN_CO=
MP_ACCESS_TOKEN_UY=
MP_ACCESS_TOKEN_PE=
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# International payment provider (to be chosen: lemonsqueezy | paddle | none)
INTL_PAYMENT_PROVIDER=none
INTL_PAYMENT_API_KEY=
INTL_PAYMENT_WEBHOOK_SECRET=
# Simulated payments when no provider is configured (always on in development)
PAYMENTS_MOCK=false

# Google AdSense (empty = placeholder slots)
NEXT_PUBLIC_ADSENSE_CLIENT=

# Limits / housekeeping
RATE_LIMIT_PER_MINUTE=20
TEMP_FILE_TTL_MINUTES=60
