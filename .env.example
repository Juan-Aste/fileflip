# Copy to .env.local and fill in. Never commit real secrets.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on the contact page
NEXT_PUBLIC_CONTACT_EMAIL=contact@fileflect.com

# MongoDB (docker-compose provides a local instance)
MONGODB_URI=mongodb://localhost:27017/fileflip

# Gotenberg (LibreOffice over HTTP). On Railway use the private network URL.
GOTENBERG_URL=http://localhost:3001
# Optional: client timeout towards Gotenberg in ms (default 95000, just over its --api-timeout=90s).
# GOTENBERG_TIMEOUT_MS=95000

# Auth.js (next-auth v5)
AUTH_SECRET=generate-with-npx-auth-secret
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Magic link email. Recommended on Railway: Resend's HTTP API (Railway blocks
# outbound SMTP on every plan below Pro). Takes priority over EMAIL_SERVER.
RESEND_API_KEY=
# Alternative: SMTP, e.g. smtp://user:pass@smtp.example.com:587 (not on Railway below Pro)
EMAIL_SERVER=
EMAIL_FROM="Fileflect <no-reply@example.com>"
# Staging without SMTP: print magic links to the server log (never in real production)
AUTH_EMAIL_LOG_LINKS=false

# Pro plan (pricing page, checkout, billing APIs and every mention of Pro).
# Off until the owner can bill: everyone is on the free plan and sees ads.
# "true" turns it on; pages built ahead take it at build time (redeploy).
PRO_ENABLED=false

# Mercado Pago (use TEST credentials). Each MP account charges in its own
# country's currency: set one token per country you sell in. MP_ACCESS_TOKEN
# is the fallback for countries without their own token.
MP_ACCESS_TOKEN=
MP_ACCESS_TOKEN_AR=
MP_ACCESS_TOKEN_BR=
MP_ACCESS_TOKEN_MX=
MP_ACCESS_TOKEN_CL=
MP_ACCESS_TOKEN_CO=
MP_ACCESS_TOKEN_UY=
MP_ACCESS_TOKEN_PE=
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# International payment provider (to be chosen: lemonsqueezy | paddle | none)
INTL_PAYMENT_PROVIDER=none
INTL_PAYMENT_API_KEY=
INTL_PAYMENT_WEBHOOK_SECRET=
# Simulated payments when no provider is configured (always on in development)
PAYMENTS_MOCK=false

# Google AdSense (empty = placeholder slots)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_RESULT=

# Own copy of the AI models (Cloudflare R2, docs/modelos-r2.md), e.g.
# https://modelos.fileflect.com. Empty = download from Hugging Face only.
NEXT_PUBLIC_MODELS_BASE_URL=

# Limits / housekeeping
RATE_LIMIT_PER_MINUTE=20
TEMP_FILE_TTL_MINUTES=60

# Admin panel (/es/admin): comma-separated emails of signed-in users allowed in.
# Empty = nobody (everyone gets a 404).
ADMIN_EMAILS=
